# Ethio-Cyber-Shield (ECS) v3.0 Deployment Configuration
# Copy this file to .env before running docker-compose up

# Database Settings
POSTGRES_DB=ecs_db
POSTGRES_USER=ecs_admin
POSTGRES_PASSWORD=ChangeMeInProduction_DbPass2026!
POSTGRES_PORT=5432

# Redis Streams Settings
REDIS_PASSWORD=ChangeMeInProduction_RedisPass2026!
REDIS_PORT=6379

# Cryptography & Security
# Generate with: openssl rand -hex 32
JWT_SECRET=e7c4a91f2b8d3e6a0f5c9b2d7e1a4f8c3b6d0e9a2f5c8b1d4e7a0f3c6b9d2e5
# Generate with: openssl rand -hex 32
ECS_MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Core API
PORT=5000
FLASK_ENV=production
FLASK_DEBUG=0
ALLOWED_ORIGINS=*

# Optional Target Synchronization
ENABLE_TARGET_POLLER=1
